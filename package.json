{
  "name": "newsaas",
  "version": "0.0.0",
  "private": true,
  "description": "NewSaaS — multi-tenant veterinary SaaS foundation",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format-check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ui": "vitest --config packages/vitest-config/vitest.ui.ts",
    "preflight": "infra/scripts/preflight.sh",
    "preflight:win": "infra/scripts/preflight.ps1",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@newsaas/eslint-config": "workspace:*",
    "@newsaas/prettier-config": "workspace:*",
    "@newsaas/typescript-config": "workspace:*",
    "@newsaas/vitest-config": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.5.3"
  }
}
