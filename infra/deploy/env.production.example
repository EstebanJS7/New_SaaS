# Plantilla de entorno para el VPS. Copiar a /opt/newsaas/env.production
# (chmod 600) y completar. NUNCA versionar el archivo con valores reales.
#
# Generar secretos con:
#   openssl rand -hex 32                  (contraseñas y BRANDING_ASSET_URL_SECRET)
#   echo "1:$(openssl rand -base64 32)"   (SECRET_STORE_MASTER_KEYS)
# Las contraseñas van dentro de DATABASE_URL y REDIS_URL: usar solo hex, sin
# caracteres como / + @ : que romperían la URL.

# --- Dominios y certificados -------------------------------------------------
APP_DOMAIN=app.ejemplo.com.py
API_DOMAIN=api.ejemplo.com.py
ACME_EMAIL=operaciones@ejemplo.com.py

# --- Imágenes (las escribe el workflow de despliegue) -------------------------
IMAGE_REGISTRY=ghcr.io/estebanjs7
IMAGE_TAG=latest

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=newsaas
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=newsaas

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=CAMBIAR

# --- Almacenamiento de objetos (MinIO interno) ---------------------------------
MINIO_ROOT_USER=newsaas
MINIO_ROOT_PASSWORD=CAMBIAR_min_8_caracteres
STORAGE_S3_BUCKET=newsaas
STORAGE_S3_REGION=us-east-1
BRANDING_ASSETS_ENABLED=true

# --- Secretos de la aplicación -------------------------------------------------
# Mínimo 32 caracteres; la API se niega a arrancar con un valor corto.
BRANDING_ASSET_URL_SECRET=CAMBIAR
# Formato <versión>:<base64 de 32 bytes>. Guardar una copia fuera del servidor:
# sin esta clave no se puede descifrar el material de firma de los tenants.
SECRET_STORE_MASTER_KEYS=CAMBIAR

# --- Fiscal -------------------------------------------------------------------
# Staging y pruebas: fake. Producción: sifen-direct + SIFEN_ENVIRONMENT.
FISCAL_PROVIDER=fake
SIFEN_ENVIRONMENT=TEST

# --- Email (worker) -------------------------------------------------------------
# Obligatorio en producción: fake (no envía nada) o smtp.
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=

# --- WhatsApp Cloud API (worker) -----------------------------------------------
# Obligatorio en producción: fake o whatsapp-cloud.
WHATSAPP_PROVIDER=fake
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TEMPLATE_NAME=
WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=es

# --- Respaldos de PostgreSQL (pgBackRest) ---------------------------------------
# Repositorio S3 externo, en otro proveedor o región que el VPS. Ejemplos:
#   Backblaze B2:  BACKUP_S3_ENDPOINT=s3.us-west-004.backblazeb2.com  BACKUP_S3_REGION=us-west-004
#   Cloudflare R2: BACKUP_S3_ENDPOINT=<cuenta>.r2.cloudflarestorage.com  BACKUP_S3_REGION=auto
BACKUP_REPO_TYPE=s3
BACKUP_REPO_PATH=/newsaas
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_KEY=
BACKUP_S3_KEY_SECRET=
# Cifra el repositorio. Guardar una copia fuera del servidor: sin ella los
# respaldos no se pueden restaurar. Generar con: openssl rand -hex 32
BACKUP_CIPHER_PASS=CAMBIAR
# Hora diaria del respaldo en UTC (6 = 03:00 en Asunción) y día del completo
# semanal (1 = lunes ... 7 = domingo).
BACKUP_HOUR_UTC=6
BACKUP_FULL_WEEKDAY=7
BACKUP_RETENTION_FULL=4
# DEC-093: aviso si un respaldo falla o deja de correr. Crear un "check" o
# "heartbeat" con período de 1 día y gracia de 2 horas y pegar su URL:
#   Healthchecks.io: https://hc-ping.com/<uuid>
#   Better Stack:    https://uptime.betterstack.com/api/v1/heartbeat/<token>
BACKUP_HEARTBEAT_URL=

# --- Seguimiento de errores (DEC-093) ----------------------------------------
# DSN del proyecto en Sentry (plan gratuito alcanza). Vacío = apagado.
# Los eventos no llevan datos de la petición ni del usuario: ver DEC-093.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
