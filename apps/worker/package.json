{
  "name": "@newsaas/worker",
  "version": "0.0.0",
  "private": true,
  "description": "NewSaaS Worker — NestJS standalone + BullMQ bootstrap",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=../../.env --import ./register-loader.js src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.16",
    "@nestjs/core": "^11.0.16",
    "@newsaas/config": "workspace:*",
    "@newsaas/database": "workspace:*",
    "@newsaas/shared": "workspace:*",
    "@newsaas/storage": "workspace:*",
    "bullmq": "^5.46.1",
    "ioredis": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@newsaas/eslint-config": "workspace:*",
    "@newsaas/typescript-config": "workspace:*",
    "@newsaas/vitest-config": "workspace:*",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
