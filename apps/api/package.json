{
  "name": "@newsaas/api",
  "version": "0.0.0",
  "private": true,
  "description": "NewSaaS API \u2014 NestJS on Fastify",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node ../../scripts/backend-dev.mjs dist/src/main.js",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --config vitest.config.ts",
    "test:treatment-search": "node --env-file=../../.env ../../scripts/verify-treatment-search.mjs",
    "test:treatment-entry": "node --env-file=../../.env ../../scripts/verify-treatment-entry.mjs",
    "test:study-entry": "node --env-file=../../.env ../../scripts/verify-study-entry.mjs",
    "test:study-search": "node --env-file=../../.env ../../scripts/verify-study-search.mjs",
    "test:weight-search": "node --env-file=../../.env ../../scripts/verify-weight-search.mjs",
    "test:weight-entry": "node --env-file=../../.env ../../scripts/verify-weight-entry.mjs",
    "test:catalog-search": "node --env-file=../../.env ../../scripts/verify-catalog-search.mjs",
    "test:customer-search": "node --env-file=../../.env ../../scripts/verify-customer-search.mjs",
    "test:sale-search": "node --env-file=../../.env ../../scripts/verify-sale-search.mjs",
    "test:patient-search": "node --env-file=../../.env ../../scripts/verify-patient-search.mjs",
    "test:clinical-links": "node --env-file=../../.env ../../scripts/verify-clinical-links.mjs",
    "test:live-pg": "vitest run --config vitest.live-pg.config.ts",
    "test:redis": "vitest run --config vitest.redis.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@nestjs/common": "^11.0.16",
    "@nestjs/core": "^11.0.16",
    "@nestjs/platform-fastify": "^11.0.16",
    "@newsaas/config": "workspace:*",
    "@newsaas/customers": "workspace:*",
    "@newsaas/database": "workspace:*",
    "@newsaas/fiscal": "workspace:*",
    "@newsaas/fiscal-persistence": "workspace:*",
    "@newsaas/imports": "workspace:*",
    "@newsaas/notifications": "workspace:*",
    "@newsaas/patients": "workspace:*",
    "@newsaas/secret-store": "workspace:*",
    "@newsaas/shared": "workspace:*",
    "@newsaas/storage": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^5.46.1",
    "file-type": "^21.3.4",
    "ioredis": "^5.11.1",
    "pino": "10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.16",
    "@newsaas/eslint-config": "workspace:*",
    "@newsaas/typescript-config": "workspace:*",
    "@newsaas/vitest-config": "workspace:*",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.24.0",
    "fastify": "^5.11.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
