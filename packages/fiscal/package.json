{
  "name": "@newsaas/fiscal",
  "version": "0.0.0",
  "private": true,
  "description": "NewSaaS shared fiscal provider boundary — port, fake, sanitizer, and NestJS module",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --config ../../packages/vitest-config/vitest.node.ts",
    "fetch:dte-schemas": "node scripts/fetch-dte-schemas.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.16",
    "asn1js": "^3.0.10",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "pkijs": "^3.4.1",
    "xml-crypto": "^6.3.3"
  },
  "devDependencies": {
    "@newsaas/eslint-config": "workspace:*",
    "@newsaas/typescript-config": "workspace:*",
    "@newsaas/vitest-config": "workspace:*",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "libxmljs2": "^0.37.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
