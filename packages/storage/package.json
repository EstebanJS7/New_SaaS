{
  "name": "@newsaas/storage",
  "version": "0.0.0",
  "private": true,
  "description": "NewSaaS shared object-storage boundary — port, drivers, keys, and NestJS module",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --config ../../packages/vitest-config/vitest.node.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
