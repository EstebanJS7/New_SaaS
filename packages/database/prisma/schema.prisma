// NewSaaS persistence foundation.
//
// Conventions (design D2):
// - snake_case tables/columns via @@map/@map; PascalCase singular models.
// - Public IDs are UUID strings defaulted by Postgres gen_random_uuid().
// - Timestamps are timestamptz stored in UTC; converted at boundaries.
// - No floating point money columns.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Staff identity (global — not tenant-scoped). Design D2.
// ---------------------------------------------------------------------------

/// Global person record. Email uniqueness is GLOBAL: login resolves the
/// profile, memberships bind profiles to tenants. Emails are lowercased by the
/// application before persisting; the column itself stores the app-normalized
/// value verbatim.
/// Data classification: email/display_name CONFIDENTIAL; status INTERNAL.
model UserProfile {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  email       String @unique
  displayName String @map("display_name")
  status      String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential      UserCredential?
  sessions        StaffSession[]
  memberships     TenantMembership[]
  auditLogs       AuditLog[]
  tenantBrandings TenantBranding[]
  brandingAssets  BrandingAsset[]

  /// Close actor for clinical encounters (EPIC-06); the audit trail remains the
  /// authoritative record.
  clinicalEncountersClosed ClinicalEncounter[] @relation("ClinicalEncounterClosedBy")

  @@map("user_profile")
}

/// RESTRICTED password material. The primary key SHARED with UserProfile means
/// regular application reads never need to join this table — only the login
/// verification path touches it (design decision; spec: identity / Argon2id
/// storage).
model UserCredential {
  /// Same value as the owning UserProfile.id (1:1, shared primary key).
  userProfileId String @id @map("user_profile_id") @db.Uuid

  /// RESTRICTED — argon2id hash. Never logged, never returned by any API.
  passwordHash String @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("user_credential")
}

/// First-party staff sessions (design D4). One row per login (rotation);
/// logout hard-deletes the row, replay therefore fails lookups.
model StaffSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userProfileId String @map("user_profile_id") @db.Uuid

  /// SHA-256 of the opaque session token — plaintext tokens never persist.
  tokenHash String @unique @map("token_hash")

  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Sessions die with their profile (the only CASCADE in EPIC-01).
  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userProfileId])
  @@map("staff_session")
}

// ---------------------------------------------------------------------------
// Tenancy core (design D2). Tenant creation is ops/seed-only — there is no
// self-service registration surface anywhere in the API.
// ---------------------------------------------------------------------------

/// Membership lifecycle. Values pinned by design D2; evolve additively only.
enum TenantMembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_membership_status")
}

/// Tenant lifecycle (DEC-005 + ADR-004). Values pinned by ADR-004; evolve
/// additively only. The public branding lookup treats SUSPENDED exactly like an
/// unknown slug; suspension commands are out of scope.
enum TenantStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

model Tenant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  slug String @unique
  name String

  status TenantStatus @default(ACTIVE) @map("status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches                    Branch[]
  memberships                 TenantMembership[]
  portalAccess                CustomerPortalAccess[]
  entitlements                TenantEntitlement[]
  auditLogs                   AuditLog[]
  rolePermissionOverrides     TenantRolePermissionOverride[]
  settingNamespaces           TenantSettingNamespace[]
  tenantBranding              TenantBranding[]
  brandingAssets              BrandingAsset[]
  brandingResetCleanupIntents BrandingResetCleanupIntent[]
  customers                   Customer[]
  customerAddresses           CustomerAddress[]
  customerContacts            CustomerContact[]
  patients                    Patient[]
  patientGuardians            PatientGuardian[]
  clinicalEncounters          ClinicalEncounter[]
  clinicalTreatments          ClinicalTreatment[]
  clinicalVaccinations        ClinicalVaccination[]
  clinicalDewormings          ClinicalDeworming[]
  clinicalStudies             ClinicalStudy[]
  clinicalWeights             ClinicalWeight[]
  appointments                Appointment[]
  portalBookingRequests       PortalBookingRequest[]
  catalogItems                CatalogItem[]
  stockMovements              StockMovement[]
  stockBalances               StockBalance[]
  suppliers                   Supplier[]
  purchases                   Purchase[]
  purchaseLines               PurchaseLine[]

  @@map("tenant")
}

/// SCHEMA-ONLY SCAFFOLD (spec: persistence / Schema inventory): Branch is inert
/// during EPIC-01 — no endpoint or service creates, reads, updates or deletes
/// rows. Route-enumeration proof lands with task 5.3.
model Branch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  name     String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  appointments Appointment[]

  /// Tenant-ownership key: target of the appointment composite branch FK so an
  /// appointment can only reference a Branch of the SAME tenant (EPIC-07).
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("branch")
}

/// Binds a global staff profile to one tenant with one role. Demonstrates the
/// tenant-safe repository pattern (spec: tenancy-core / Repository pattern).
model TenantMembership {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId      String                 @map("tenant_id") @db.Uuid
  userProfileId String                 @map("user_profile_id") @db.Uuid
  roleId        String                 @map("role_id") @db.Uuid
  status        TenantMembershipStatus

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Appointments where this membership is the assigned professional.
  appointments Appointment[]

  /// One membership per (tenant, profile).
  @@unique([tenantId, userProfileId])
  /// Tenant-ownership key: target of the appointment composite professional FK.
  @@unique([tenantId, id])
  /// Login resolves memberships by profile; the (tenant_id, profile) unique
  /// index cannot serve that lookup (leading column is tenant_id).
  @@index([userProfileId])
  @@map("tenant_membership")
}

/// First-party, Customer-linked portal holder (EPIC-08 D1). Exactly one ACTIVE
/// holder per Customer is enforced by the partial unique index
/// `customer_portal_access_active_customer_key` on (tenant_id, customer_id)
/// WHERE status = 'ACTIVE', declared as raw SQL in the portal migration because
/// Prisma cannot express partial indexes. The login id (`contactEmail`, D8) is
/// canonicalized with lower() on both input handling and the DB key: the partial
/// unique index `customer_portal_access_active_contact_email_key` on
/// (tenant_id, lower(contact_email)) WHERE status = 'ACTIVE' pins one ACTIVE
/// holder per tenant canonical email — case-variant rows included — so
/// tenant-scoped portal login can never resolve an ambiguous holder.
/// `status` carries the lifecycle string 'ACTIVE' | 'REVOKED'; revocation
/// invalidates sessions and the audited row is never deleted.
/// Data classification: contact_email INTERNAL — never logged.
model CustomerPortalAccess {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId   String @map("tenant_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  contactEmail String @map("contact_email")
  status       String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: the Customer must belong to the same tenant.
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  credential PortalCredential?
  sessions   PortalSession[]
  auditLogs  AuditLog[]

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_portal_access")
}

/// RESTRICTED portal password material (EPIC-08 D1). The primary key is SHARED
/// with CustomerPortalAccess so regular application reads never join this table —
/// only the portal login verification path touches it (argon2id).
model PortalCredential {
  /// Same value as the owning CustomerPortalAccess.id (1:1, shared primary key).
  portalAccessId String @id @map("portal_access_id") @db.Uuid

  /// RESTRICTED — argon2id hash. Never logged, never returned by any API.
  passwordHash String @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  portalAccess CustomerPortalAccess @relation(fields: [portalAccessId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("portal_credential")
}

/// First-party portal sessions (EPIC-08 D1). One row per login; revocation sets
/// `revokedAt` rather than deleting the row. Sessions die with their access via
/// CASCADE — the deliberate session exception to the RESTRICT rule (mirrors
/// staff_session).
model PortalSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  portalAccessId String @map("portal_access_id") @db.Uuid

  /// SHA-256 of the opaque session token — plaintext tokens never persist.
  tokenHash String @unique @map("token_hash")

  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  portalAccess CustomerPortalAccess @relation(fields: [portalAccessId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([portalAccessId])
  @@map("portal_session")
}

// ---------------------------------------------------------------------------
// RBAC reference data (design D2). Seeded inertly by the reference seed — no
// role-management UI or CRUD API exists (spec: RBAC scope fence). Policy
// evaluation belongs to EPIC-02.
// ---------------------------------------------------------------------------

/// Staff role catalog. `code` is the stable natural key used by the reference
/// seed (OWNER, ADMIN, VETERINARIAN, RECEPTIONIST, CASHIER, INVENTORY_MANAGER).
model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @unique
  name String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships               TenantMembership[]
  rolePermissions           RolePermission[]
  tenantPermissionOverrides TenantRolePermissionOverride[]

  @@map("role")
}

/// Permission catalog. `key` is the stable natural key with the PRD §9
/// `domain.resource.action` shape; uniqueness is global.
model Permission {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  key  String @unique
  name String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permission")
}

/// Role↔permission binding. Surrogate UUID PK plus a compound unique on the
/// pair so the reference seed can upsert by the natural keys.
model RolePermission {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

/// Tenant-LOCAL permission override over a GLOBAL catalog role (EPIC-02,
/// DEC-003). Roles and the permission catalog stay platform baseline
/// (seed-owned CODE); this table is the per-tenant SANDBOX that re-targets a
/// role's effective key set without touching shared rows — the adversarial
/// review (CRITICAL-1) showed globally mutable mappings would let any one
/// tenant rewrite every other tenant's authority.
///
/// Effective set of (tenant T, role R) =
///   (role_permission baseline for R  ∪  overrides(T,R) with granted=true)
///   − overrides(T,R) with granted=false.
///
/// `permission_key` stores the catalog KEY (not an FK): catalog membership is
/// validated at service level against PERMISSION_SEEDS, keeping the override
/// row self-describing while the catalog itself stays immutable code.
model TenantRolePermissionOverride {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId      String  @map("tenant_id") @db.Uuid
  roleId        String  @map("role_id") @db.Uuid
  permissionKey String  @map("permission_key")
  granted       Boolean

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// One override verdict per (tenant, role, catalog key).
  @@unique([tenantId, roleId, permissionKey])
  /// Tenant-scoped administration lookups resolve by (tenant, role).
  @@index([tenantId, roleId])
  @@map("tenant_role_permission_override")
}

/// Typed, versioned settings data scoped to exactly one tenant and namespace.
/// The JSON payload is application-validated through the API registry before it
/// reaches this persistence boundary.
model TenantSettingNamespace {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  namespace     String
  schemaVersion Int      @map("schema_version")
  data          Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, namespace])
  @@index([tenantId])
  @@map("tenant_setting_namespace")
}

/// Tenant-specific brand overrides that layer on top of the product preset.
/// One row per tenant; a missing row means the tenant falls back to the
/// product brand preset. The JSON payload is validated against the versioned
/// v1 `brandOverrideSchema` before it reaches this persistence boundary.
model TenantBranding {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId      String @unique @map("tenant_id") @db.Uuid
  schemaVersion Int    @map("schema_version")
  overrides     Json   @map("overrides")

  /// Human-readable display name for the branded product/tenant.
  displayName String? @map("display_name")

  /// Nullable asset FKs; ON DELETE SET NULL keeps the tenant branding row
  /// valid when an asset is replaced or removed. Unique so each asset is
  /// referenced by at most one tenant branding row.
  logoLightAssetId String? @unique @map("logo_light_asset_id") @db.Uuid
  logoDarkAssetId  String? @unique @map("logo_dark_asset_id") @db.Uuid
  faviconAssetId   String? @unique @map("favicon_asset_id") @db.Uuid

  updatedByUserProfileId String? @map("updated_by_user_profile_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy UserProfile? @relation(fields: [updatedByUserProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  logoLightAsset BrandingAsset? @relation("TenantBrandingLogoLight", fields: [logoLightAssetId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  logoDarkAsset  BrandingAsset? @relation("TenantBrandingLogoDark", fields: [logoDarkAssetId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  faviconAsset   BrandingAsset? @relation("TenantBrandingFavicon", fields: [faviconAssetId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@map("tenant_branding")
}

/// Kind discriminator for tenant-owned branding assets. Values are pinned;
/// evolve additively only.
enum BrandingAssetKind {
  LOGO_LIGHT
  LOGO_DARK
  FAVICON

  @@map("branding_asset_kind")
}

/// Tenant-owned logo/favicon asset metadata. Only opaque storage keys are
/// persisted here; bytes live in the approved object-storage boundary.
/// Data classification: assetKey is INTERNAL — never returned to clients.
model BrandingAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String            @map("tenant_id") @db.Uuid
  kind     BrandingAssetKind

  /// Opaque, random storage key. Bucket/path details live inside StoragePort.
  assetKey String @map("asset_key")

  /// Approved MIME type validated by magic-byte sniff.
  contentType String @map("content_type")

  /// Size in bytes, validated against per-kind caps before storage.
  byteSize Int @map("byte_size")

  /// Hex SHA-256 of the stored bytes; integrity + idempotency signal.
  sha256 String

  uploadedByUserProfileId String @map("uploaded_by_user_profile_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy UserProfile @relation(fields: [uploadedByUserProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  logoLightTenantBranding TenantBranding? @relation("TenantBrandingLogoLight")
  logoDarkTenantBranding  TenantBranding? @relation("TenantBrandingLogoDark")
  faviconTenantBranding   TenantBranding? @relation("TenantBrandingFavicon")

  @@unique([tenantId, kind])
  @@index([tenantId])
  @@map("branding_asset")
}

/// Durable, single-purpose cleanup status for reset-disconnected storage
/// objects. Values are pinned; evolve additively only.
enum BrandingResetCleanupStatus {
  PENDING
  COMPLETED
  DEAD_LETTER

  @@map("branding_reset_cleanup_status")
}

/// Durable intent to retire the storage objects captured during a branding
/// reset. Inserted inside the reset transaction and enqueued after commit, so
/// cleanup survives a crash between the two. Deliberately single-purpose — not
/// a generic job/outbox model.
/// Data classification: storageKeys INTERNAL (opaque object keys, never logged
/// as a list); lastError INTERNAL (sanitized message, no sensitive payloads).
model BrandingResetCleanupIntent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Owning tenant; the worker only addresses intents by id AND tenantId.
  tenantId String @map("tenant_id") @db.Uuid

  /// Originating `branding.reset` audit row (reference by value).
  resetAuditId String? @map("reset_audit_id") @db.Uuid

  /// Staff profile that requested the reset (reference by value).
  requestedByUserProfileId String? @map("requested_by_user_profile_id") @db.Uuid

  /// Opaque storage keys captured by the reset transaction.
  storageKeys String[] @map("storage_keys")

  status    BrandingResetCleanupStatus @default(PENDING)
  attempts  Int                        @default(0)
  lastError String?                    @map("last_error")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, createdAt])
  @@map("branding_reset_cleanup_intent")
}

// ---------------------------------------------------------------------------
// Entitlements boundary (design D8): boolean capability grants per tenant over
// seeded feature codes. No automatic grants exist — access requires an explicit
// tenant_entitlement row. Callers consult EntitlementsService.has() (task 7.1),
// never plan comparisons.
// ---------------------------------------------------------------------------

/// Feature capability catalog. `code` is the stable natural key; the twelve
/// MVP codes are pinned by PRD §10.
model FeatureCode {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @unique

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  planCapabilities PlanCapability[]
  entitlements     TenantEntitlement[]

  @@map("feature_code")
}

/// Plan catalog. Plans never gate anything directly — they only pre-map
/// feature codes via plan_capability; enforcement goes through grants.
model Plan {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @unique
  name String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  planCapabilities PlanCapability[]

  @@map("plan")
}

/// Plan↔feature-code mapping (the inert starter plan maps all twelve codes).
model PlanCapability {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  planId        String @map("plan_id") @db.Uuid
  featureCodeId String @map("feature_code_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  featureCode FeatureCode @relation(fields: [featureCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([planId, featureCodeId])
  @@map("plan_capability")
}

/// Explicit per-tenant grant. UNIQUE(tenant_id, feature_code_id) doubles as
/// the lookup index for `has(tenantId, featureCode)`.
model TenantEntitlement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  featureCodeId String @map("feature_code_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  featureCode FeatureCode @relation(fields: [featureCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, featureCodeId])
  @@map("tenant_entitlement")
}

// ---------------------------------------------------------------------------
// Customer core (EPIC-04). Tenant-scoped Customer aggregate with child
// Address/Contact entities and an inert PatientGuardian scaffold.
// ---------------------------------------------------------------------------

/// Customer legal form. Values are pinned by design D1; evolve additively only.
enum CustomerKind {
  INDIVIDUAL
  COMPANY

  @@map("customer_kind")
}

/// Contact channel kind. Values pinned by design; evolve additively only.
enum CustomerContactKind {
  EMAIL
  PHONE

  @@map("customer_contact_kind")
}

/// Tenant-scoped customer aggregate (individual or company). Data
/// classification: display_name, legal_name, tax_id, first_name, last_name and
/// document_number are CONFIDENTIAL; application logs must carry IDs only.
model Customer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  kind        CustomerKind
  displayName String       @map("display_name")

  legalName String? @map("legal_name")
  taxId     String? @map("tax_id")

  firstName      String? @map("first_name")
  lastName       String? @map("last_name")
  documentNumber String? @map("document_number")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addresses CustomerAddress[]
  contacts  CustomerContact[]
  guardians PatientGuardian[]

  portalAccess          CustomerPortalAccess[]
  portalBookingRequests PortalBookingRequest[]

  /// Tenant-ownership key: target of the portal composite customer FKs.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("customer")
}

/// Tenant-scoped address belonging to exactly one Customer.
model CustomerAddress {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId   String @map("tenant_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  label       String?
  line1       String?
  line2       String?
  city        String?
  state       String?
  postalCode  String? @map("postal_code")
  countryCode String? @map("country_code")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_address")
}

/// Tenant-scoped contact channel belonging to exactly one Customer.
model CustomerContact {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId   String @map("tenant_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  kind  CustomerContactKind
  label String?
  value String

  isPrimary Boolean @default(false) @map("is_primary")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_contact")
}

/// Tenant-scoped guardian bridge between a Veterinary Patient and a Core
/// Customer (Veterinary → Core only). Activated by the EPIC-05 patients
/// migration; the `patient_id` FK is RESTRICT and rows are never hard-deleted.
///
/// Exactly-one active primary guardian (Decision #2210):
/// - "at most one" is enforced by the partial unique index
///   `patient_guardian_primary_active_key` on `(patient_id) WHERE is_primary AND is_active`,
///   declared as raw SQL in the patients migration because Prisma cannot
///   express partial indexes;
/// - "at least one" is enforced by a `DEFERRABLE INITIALLY DEFERRED` constraint
///   trigger in the same migration. A primary swap MUST demote the current
///   primary before promoting the replacement so the immediate partial index
///   holds intra-transaction; the deferred trigger re-checks exactly one at
///   commit.
/// Data classification: the Patient↔Customer link is CONFIDENTIAL; logs/audit
/// carry stable IDs only.
model PatientGuardian {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId   String @map("tenant_id") @db.Uuid
  patientId  String @map("patient_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  isPrimary Boolean @default(false) @map("is_primary")
  isActive  Boolean @default(true) @map("is_active")

  /// Display order within a Patient's guardian list. No longer part of the
  /// unique key (the link unique is now `(patient_id, customer_id)`).
  position Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// One guardian link per (patient, customer).
  @@unique([patientId, customerId])
  @@index([tenantId])
  @@index([customerId])
  @@map("patient_guardian")
}

// ---------------------------------------------------------------------------
// Veterinary Patients (EPIC-05, PAT-001 data foundation). Patient and
// PatientGuardian are tenant-scoped; Species/Breed are GLOBAL seeded reference
// catalogs (Decision #2211) mirroring FeatureCode/Role — never tenant-scoped.
// Core domains never import this module; Patient → Customer is one-way.
// ---------------------------------------------------------------------------

/// Patient sex. Values are pinned; evolve additively only.
enum PatientSex {
  MALE
  FEMALE
  UNKNOWN

  @@map("patient_sex")
}

/// GLOBAL system-seeded species catalog (Decision #2211). Not tenant-scoped;
/// `code` is the stable natural key used by the reference seed.
model Species {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @unique
  name String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  breeds   Breed[]
  patients Patient[]

  @@map("species")
}

/// GLOBAL system-seeded breed catalog (Decision #2211). Each Breed belongs to
/// exactly one Species; `(species_id, code)` is the stable natural key. Not
/// tenant-scoped and never tenant-filtered.
model Breed {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  speciesId String @map("species_id") @db.Uuid

  code String
  name String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  species  Species   @relation(fields: [speciesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patients Patient[]

  @@unique([speciesId, code])
  @@map("breed")
}

/// Tenant-scoped Patient identity. Hard delete does not exist; deactivation is
/// the only removal. Species/Breed are GLOBAL foreign keys and MUST NOT be
/// tenant-filtered.
/// Data classification: name and birthDate are CONFIDENTIAL; logs/audit carry
/// stable IDs only.
model Patient {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  name String

  /// Global catalog references (Decision #2211) — RESTRICT keeps the taxonomy
  /// immutable while Patients reference it.
  speciesId String  @map("species_id") @db.Uuid
  breedId   String? @map("breed_id") @db.Uuid

  sex       PatientSex
  birthDate DateTime?  @map("birth_date") @db.Timestamptz(3)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  species   Species           @relation(fields: [speciesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  breed     Breed?            @relation(fields: [breedId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  guardians PatientGuardian[]

  clinicalEncounters   ClinicalEncounter[]
  clinicalTreatments   ClinicalTreatment[]
  clinicalVaccinations ClinicalVaccination[]
  clinicalDewormings   ClinicalDeworming[]
  clinicalStudies      ClinicalStudy[]
  clinicalWeights      ClinicalWeight[]

  appointments Appointment[]

  portalBookingRequests PortalBookingRequest[]

  /// Tenant-ownership key: the target of every clinical composite FK so a
  /// clinical row can only reference a Patient of the SAME tenant.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([speciesId])
  @@index([breedId])
  @@map("patient")
}

// ---------------------------------------------------------------------------
// Veterinary Clinical Records (EPIC-06 CLI data foundation). All six models are
// tenant-scoped and Patient-anchored; Core domains never import this module.
// No clinical row is hard-deletable: the migration rejects DELETE, and a CLOSED
// encounter is corrected only through a linked, audited amendment row
// (`amendsEncounterId`). Data classification: all clinical content is
// CONFIDENTIAL; `internalNotes` is staff-only and MUST NOT reach a client-safe
// projection or the Portal.
// ---------------------------------------------------------------------------

/// Clinical encounter lifecycle. Values are pinned; evolve additively only.
enum ClinicalEncounterStatus {
  DRAFT
  CLOSED

  @@map("clinical_encounter_status")
}

/// Tenant-scoped clinical encounter anchored to one Patient. Starts `DRAFT`;
/// DRAFT is autosaved under an explicit `version` guard; `CLOSED` is immutable
/// and corrected only by a linked amendment. A repeated amendment request with
/// the same `idempotencyKey` resolves to the existing row via the
/// `(tenant_id, idempotency_key)` unique.
model ClinicalEncounter {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId  String @map("tenant_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  status  ClinicalEncounterStatus @default(DRAFT)
  version Int                     @default(1)

  reasonForVisit String? @map("reason_for_visit")
  anamnesis      String?
  diagnosis      String?
  treatmentPlan  String? @map("treatment_plan")

  /// CONFIDENTIAL free-form clinical notes; staff-only, never client-safe.
  internalNotes String? @map("internal_notes")
  /// Client-safe summary; Portal delivery is deferred to EPIC-08.
  clientSummary String? @map("client_summary")

  /// Explicit correction link: an amendment is a CLOSED row that points at the
  /// original; the original is never mutated.
  amendsEncounterId String? @map("amends_encounter_id") @db.Uuid
  amendmentReason   String? @map("amendment_reason")
  /// Nullable request idempotency key; unique per tenant when present.
  idempotencyKey    String? @map("idempotency_key")

  closedAt              DateTime? @map("closed_at") @db.Timestamptz(3)
  closedByUserProfileId String?   @map("closed_by_user_profile_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK (see ClinicalTreatment).
  patient         Patient             @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  closedByProfile UserProfile?        @relation("ClinicalEncounterClosedBy", fields: [closedByUserProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite amendment link: an amendment can only point at an original in
  /// the SAME tenant. The pair is skipped by PostgreSQL MATCH SIMPLE while
  /// `amends_encounter_id` is NULL, so ordinary encounters are unaffected.
  amendsEncounter ClinicalEncounter?  @relation("ClinicalEncounterAmendment", fields: [tenantId, amendsEncounterId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  amendments      ClinicalEncounter[] @relation("ClinicalEncounterAmendment")

  /// Tenant-ownership key: target of the composite amendment self-FK.
  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("clinical_encounter")
}

/// Treatment record (minimum facts: description, administration date/context).
model ClinicalTreatment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId  String @map("tenant_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  description    String
  administeredAt DateTime @map("administered_at") @db.Timestamptz(3)
  context        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: a clinical row can only anchor to a Patient
  /// of the same tenant. `patient_id` is redundant in the FK on purpose — the
  /// pair proves ownership and makes a cross-tenant reference impossible.
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, patientId])
  @@map("clinical_treatment")
}

/// Vaccination record (minimum facts: vaccine reference, administered date).
model ClinicalVaccination {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId  String @map("tenant_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  vaccine        String
  administeredAt DateTime @map("administered_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK (see ClinicalTreatment).
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, patientId])
  @@map("clinical_vaccination")
}

/// Deworming record (minimum facts: product, administered date).
model ClinicalDeworming {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId  String @map("tenant_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  product        String
  administeredAt DateTime @map("administered_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK (see ClinicalTreatment).
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, patientId])
  @@map("clinical_deworming")
}

/// Study record (minimum facts: study type, performed date, result).
model ClinicalStudy {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId  String @map("tenant_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  studyType   String   @map("study_type")
  performedAt DateTime @map("performed_at") @db.Timestamptz(3)
  result      String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK (see ClinicalTreatment).
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, patientId])
  @@map("clinical_study")
}

/// Weight record (minimum facts: positive measured quantity, measured date).
/// Decimal preserves precision; the migration also pins `quantity > 0` as a
/// CHECK constraint so the API validation cannot be bypassed at the DB level.
model ClinicalWeight {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId  String @map("tenant_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  quantity   Decimal  @db.Decimal(10, 3)
  measuredAt DateTime @map("measured_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK (see ClinicalTreatment).
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, patientId])
  @@map("clinical_weight")
}

// ---------------------------------------------------------------------------
// Veterinary Scheduling (EPIC-07 SCH data foundation). Tenant- and
// branch-scoped appointments assigned to an in-tenant VETERINARIAN membership
// and anchored to an in-tenant Patient. Availability windows, one-off blocks
// and the overlap policy live in the typed `scheduling` settings namespace —
// never here. No appointment row is hard-deletable: the migration rejects
// DELETE. Data classification: appointment scheduling details are CONFIDENTIAL;
// logs/audit carry stable IDs only.
// ---------------------------------------------------------------------------

/// Appointment provenance (EPIC-08 D4). Staff-created rows default to STAFF;
/// portal booking approval writes PORTAL. Evolve additively only.
enum AppointmentSource {
  STAFF
  PORTAL

  @@map("appointment_source")
}

/// Appointment lifecycle. Values are pinned by the EPIC-07 spec; evolve
/// additively only. COMPLETED, CANCELLED and NO_SHOW are terminal states.
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

/// Tenant- and branch-scoped appointment assigned to one in-tenant
/// `TenantMembership` (role VETERINARIAN, a service rule) and anchored to one
/// in-tenant Patient via composite `(tenant_id, x_id)` FKs. Start/end persist in
/// UTC. Reschedule is guarded by an explicit `version`. There is still no
/// clinical-encounter linkage; the OPTIONAL Catalog SERVICE association below
/// was added by EPIC-09 WU4 and never derives `durationMinutes`.
model Appointment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId                 String @map("tenant_id") @db.Uuid
  branchId                 String @map("branch_id") @db.Uuid
  patientId                String @map("patient_id") @db.Uuid
  professionalMembershipId String @map("professional_membership_id") @db.Uuid

  status                 AppointmentStatus @default(SCHEDULED)
  /// Provenance (EPIC-08 D4). Existing staff rows default to STAFF.
  source                 AppointmentSource @default(STAFF)
  /// Nullable provenance link to the Portal booking request this appointment
  /// fulfils; the unique below makes a repeated approval idempotent.
  portalBookingRequestId String?           @map("portal_booking_request_id") @db.Uuid
  /// OPTIONAL Catalog SERVICE association (EPIC-09 WU4 CAT-005). Nullable, so
  /// every existing and portal-created appointment stays valid and no row is
  /// ever rewritten. The duration remains the caller-supplied `startAt`/`endAt`
  /// span; the service never derives or overwrites it, and no price, tax, rate
  /// or currency value crosses this reference.
  serviceId              String?           @map("service_id") @db.Uuid
  /// Optimistic-concurrency guard for the reschedule command.
  version                Int               @default(1)

  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt   DateTime @map("end_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: the Branch must belong to the same tenant.
  branch                 Branch                @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK (see ClinicalTreatment).
  patient                Patient               @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: the professional membership must be in the same tenant.
  professionalMembership TenantMembership      @relation(fields: [tenantId, professionalMembershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK (EPIC-08): the booking request must be in the same tenant.
  portalBookingRequest   PortalBookingRequest? @relation(fields: [tenantId, portalBookingRequestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// OPTIONAL composite tenant-ownership FK (EPIC-09 WU4): when a service is
  /// attached, the referenced CatalogItem must be in the SAME tenant. The
  /// database carries ownership only; "kind = SERVICE" and "isActive" are
  /// application rules re-asserted on every write.
  service                CatalogItem?          @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  /// Tenant-ownership key: keeps a future clinical-encounter linkage additive.
  @@unique([tenantId, id])
  /// One appointment per portal booking request (nullable unique: staff rows
  /// carry NULL and PostgreSQL treats NULLs as distinct).
  @@unique([tenantId, portalBookingRequestId])
  @@index([tenantId, branchId])
  @@index([tenantId, professionalMembershipId])
  @@index([tenantId, patientId])
  @@index([tenantId, serviceId])
  @@index([tenantId, status])
  @@map("appointment")
}

// ---------------------------------------------------------------------------
// Portal booking requests (EPIC-08 D3). Pending requests live OUTSIDE the
// appointment overlap ledger: they never create or occupy a SCHEDULED
// appointment and only become one through an audited, idempotent staff approval
// command. Tenant scoping uses composite tenant-ownership FKs so a request can
// only reference a Customer/Patient of the SAME tenant.
// Data classification: scheduling details and the Patient/Customer link are
// CONFIDENTIAL; logs/audit carry stable IDs only.
// ---------------------------------------------------------------------------

/// Portal booking request lifecycle (EPIC-08 D3). Evolve additively only.
enum PortalBookingRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("portal_booking_request_status")
}

/// A holder-submitted booking request that staff must approve. Created only for
/// a holder-owned Patient; the database enforces a valid ordered UTC range.
model PortalBookingRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId   String @map("tenant_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  patientId  String @map("patient_id") @db.Uuid

  status PortalBookingRequestStatus @default(PENDING)

  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt   DateTime @map("end_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: the Customer must be in the same tenant.
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: the Patient must be in the same tenant.
  patient  Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  /// Reverse of the nullable unique Appointment provenance link.
  appointment Appointment?

  /// Tenant-ownership key: target of Appointment.portalBookingRequestId.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, patientId])
  @@map("portal_booking_request")
}

// ---------------------------------------------------------------------------
// Catalog and Taxes (EPIC-09 WU1 CAT-001 data foundation). TaxRate is GLOBAL
// seeded reference data mirroring Species/Breed — never tenant-scoped. The
// CatalogItem aggregate is tenant-scoped and references exactly one global rate
// through a RESTRICT foreign key. The optional reference price is an
// amount/currency pair (DEC-010) and is informational only: no sale, invoice,
// cash or fiscal value is derived from it. EPIC-10 WU1 (CAT-006) added the ONE
// stock dimension — `tracksStock`, defaulted by kind — while SKU, barcode,
// category, unit and branch stay absent (EPIC-12 owns POS). Data
// classification: catalog configuration is INTERNAL.
// ---------------------------------------------------------------------------

/// Catalog item kind (PRD §15). Values are pinned; evolve additively only.
enum CatalogItemKind {
  PRODUCT
  SERVICE
  MEDICATION
  SUPPLY

  @@map("catalog_item_kind")
}

/// GLOBAL system-seeded Paraguay tax-rate catalog (PRD §15, DEC-010). Not
/// tenant-scoped: every tenant reads the seeded rows (`EXEMPT`, `IVA_5`,
/// `IVA_10`) and can never create, edit, deactivate or delete one. `code` is the
/// stable natural key used by the reference seed; `rate` is a percentage stored
/// as DECIMAL(5,2) with a non-negative CHECK in the migration. This model
/// defines no arithmetic: no tax-included/excluded interpretation, calculation,
/// rounding or currency conversion is derived from it.
model TaxRate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String  @unique
  name String
  rate Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  catalogItems CatalogItem[]

  @@map("tax_rate")
}

/// Tenant-scoped catalog item (PRD §15, EPIC-09 WU1). Every item references
/// exactly one GLOBAL seeded TaxRate — `taxRateId` is NOT NULL — through a
/// RESTRICT foreign key, so a rate-less item is not a representable state and a
/// referenced rate can never be deleted. Removal is deactivation
/// (`isActive = false`); the migration rejects DELETE.
///
/// The optional reference price is an amount/currency pair (DEC-010): both
/// present or both absent, validated server-side and by a database CHECK. It is
/// informational — no sale, invoice, cash or fiscal total is derived from it.
model CatalogItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String          @map("tenant_id") @db.Uuid
  kind     CatalogItemKind

  name String

  /// Global rate reference (PRD §15): NOT NULL and RESTRICT, so the seeded rate
  /// must exist before an item is inserted and is never tenant-filtered.
  taxRateId String @map("tax_rate_id") @db.Uuid

  /// Optional reference price amount/currency pair (DEC-010). Both columns are
  /// nullable and are validated as one pair; DEC-010 deliberately fixes the
  /// scale at Decimal(14, 2) for every currency, so the catalog implies no
  /// per-currency arithmetic.
  referencePriceAmount   Decimal? @map("reference_price_amount") @db.Decimal(14, 2)
  referencePriceCurrency String?  @map("reference_price_currency") @db.VarChar(3)

  isActive Boolean @default(true) @map("is_active")

  /// EPIC-10 WU1 stock dimension (PRD §16). NOT NULL with a database default of
  /// true; the inventory migration backfills existing rows BY KIND
  /// (PRODUCT/MEDICATION/SUPPLY true, SERVICE false) and the write path sets it
  /// explicitly by kind. It is the only stock dimension on the catalog — no
  /// SKU, barcode, category, unit or branch column exists.
  tracksStock Boolean @default(true) @map("tracks_stock")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  taxRate TaxRate @relation(fields: [taxRateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// OPTIONAL back-reference of the Appointment service association (EPIC-09
  /// WU4). No catalog column is added or changed by that linkage.
  appointments Appointment[]

  /// EPIC-10 ledger back-references: the immutable movements and the balance
  /// projection that belong to this item.
  stockMovements StockMovement[]
  stockBalances  StockBalance[]

  /// EPIC-11 purchase back-reference: the draft lines that reference this item
  /// through the composite tenant-ownership FK.
  purchaseLines PurchaseLine[]

  /// Tenant-ownership key: target of the composite service FK from Appointment
  /// (EPIC-09 WU4) and of the composite item FKs from the EPIC-10 stock ledger,
  /// so a service item or a stock row can only be referenced by a row of the
  /// SAME tenant.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([taxRateId])
  @@map("catalog_item")
}

// ---------------------------------------------------------------------------
// Inventory ledger (EPIC-10 WU1 CAT-006 data foundation). Tenant-scoped,
// ledger-based stock per PRD §16: `StockMovement` is the auditable source of
// truth and `StockBalance` is a transactional projection, one row per
// (tenant, item). Movements are created confirmed and signed (inputs positive,
// outputs negative), with a mandatory reason and a non-zero quantity CHECK.
// Immutability is a database property: the migration rejects DELETE with a
// trigger and declares no UPDATE semantics, so a correction is a compensating
// movement linked through the reserved `reversesMovementId` self-FK (the
// reversal command lands in a later slice). There is no location, branch or
// warehouse dimension and no arithmetic beyond the quantity CHECKs; the
// negative-stock policy is a fixed BLOCK in the application layer. Data
// classification: stock quantities and adjustment reasons are INTERNAL; logs
// and audit carry stable IDs only.
// ---------------------------------------------------------------------------

/// Stock movement kind (PRD §16). This slice ships ONLY the standalone signed
/// adjustment; PURCHASE, SALE, TRANSFER_* and the *_REVERSAL compensations
/// belong to EPIC-11/EPIC-12 and are added additively then. Evolve additively
/// only.
enum StockMovementType {
  ADJUSTMENT

  @@map("stock_movement_type")
}

/// Immutable stock ledger entry (PRD §16). `quantity` is signed — inputs
/// positive, outputs negative — with a database CHECK rejecting zero, and
/// `reason` is mandatory. Tenant ownership is carried by the composite
/// `(tenant_id, catalog_item_id)` FK to `catalog_item`, so a movement can only
/// reference an item of the SAME tenant. `reversesMovementId` is the reserved
/// self-reference a future compensating movement uses; nothing populates it in
/// this slice.
model StockMovement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId      String            @map("tenant_id") @db.Uuid
  catalogItemId String            @map("catalog_item_id") @db.Uuid
  type          StockMovementType

  /// Signed quantity: positive is an input, negative an output. NOT NULL with a
  /// database CHECK rejecting zero, so a movement always moves stock.
  quantity Decimal @db.Decimal(10, 3)

  reason String

  /// Reserved compensating link: a reversal points at the movement it
  /// compensates. Nullable — every adjustment shipped in this slice carries
  /// NULL. The composite self-FK keeps the referenced movement in the same
  /// tenant.
  reversesMovementId String? @map("reverses_movement_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: the CatalogItem must be in the SAME tenant.
  catalogItem CatalogItem @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership self-FK for the compensating link (reserved).
  reversesMovement StockMovement?  @relation("StockMovementReversal", fields: [tenantId, reversesMovementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reversals        StockMovement[] @relation("StockMovementReversal")

  /// Tenant-ownership key: target of the composite item FK and of the
  /// compensating self-FK.
  @@unique([tenantId, id])
  @@index([tenantId, catalogItemId])
  @@index([tenantId, reversesMovementId])
  @@map("stock_movement")
}

/// Transactional stock projection (PRD §16): exactly one row per (tenant,
/// item), updated in the SAME transaction as the movements that change it.
/// `quantity` is non-negative by database CHECK — under the fixed BLOCK policy
/// the projection never goes below zero. It is a projection, never the source
/// of truth: the ledger owns the history.
model StockBalance {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId      String  @map("tenant_id") @db.Uuid
  catalogItemId String  @map("catalog_item_id") @db.Uuid
  quantity      Decimal @db.Decimal(10, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: the CatalogItem must be in the SAME tenant.
  catalogItem CatalogItem @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  /// Exactly one balance row per (tenant, item).
  @@unique([tenantId, catalogItemId])
  @@map("stock_balance")
}

// ---------------------------------------------------------------------------
// Suppliers (EPIC-11 WU1 SUP-001 data foundation). Tenant-scoped registry of
// the Core `suppliers` domain (PRD §5) referenced by EPIC-11 purchases (PRD
// §17). Identity data only: no balance, no owed amount and no payment state.
// Lifecycle is the catalog's — removal is deactivation through `isActive` and
// the migration rejects DELETE — so a purchase keeps its supplier reference.
// `taxId` is unique per tenant WHEN PRESENT through the explicit partial unique
// index `(tenant_id, tax_id) WHERE tax_id IS NOT NULL`, declared as raw SQL in
// the suppliers migration because Prisma cannot express partial indexes, so
// absent identifiers are outside the index entirely while a repeated present
// value inside one tenant is rejected. Data classification: taxId, legalName,
// email, phone and address are CONFIDENTIAL; name is INTERNAL; application logs
// carry ids only.
// ---------------------------------------------------------------------------

/// Tenant-scoped supplier register (DEC-011). `name` is required, 1..200
/// characters and deliberately NOT unique (two real suppliers may share a
/// trading name); the optional fiscal/contact fields carry only what a purchase
/// reference needs.
///
/// Per-tenant `taxId` uniqueness WHEN PRESENT is enforced by the partial unique
/// index `supplier_tenant_id_tax_id_key` on (tenant_id, tax_id) WHERE tax_id IS
/// NOT NULL, declared as raw SQL in the suppliers migration because Prisma
/// cannot express partial indexes. Absent identifiers are outside the index
/// entirely, so any number of suppliers may omit `taxId` while a repeated
/// present value inside one tenant is rejected. The composite `(tenantId, id)`
/// ownership key targets the supplier FK from the EPIC-11 purchase aggregate.
/// Data classification: taxId, legalName, email, phone and
/// address are CONFIDENTIAL; name is INTERNAL; application logs carry ids only.
model Supplier {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// Trading name. Required, bounded to 1..200 characters by the column and the
  /// migration CHECK, matching the W2 DTO bound.
  name String @db.VarChar(200)

  /// Optional identity/contact fields (DEC-011), all CONFIDENTIAL. Bounds are
  /// deliberately modest and mirror the `Customer` precedent: a legal name
  /// shares the trading-name bound, a tax identifier and a phone stay short
  /// free text, an email fits the RFC 5321 maximum and an address is free text.
  legalName String? @map("legal_name") @db.VarChar(200)
  taxId     String? @map("tax_id") @db.VarChar(50)
  email     String? @db.VarChar(320)
  phone     String? @db.VarChar(50)
  address   String? @db.VarChar(500)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// EPIC-11 purchase back-reference: the purchases that reference this
  /// supplier through the composite tenant-ownership FK.
  purchases Purchase[]

  /// Tenant-ownership key: target of the composite supplier FK from the EPIC-11
  /// purchase aggregate, so a purchase can only reference a supplier of the
  /// SAME tenant.
  @@unique([tenantId, id])
  /// Tenant list lookup: `(tenant_id, name)` serves the alphabetical supplier
  /// list without a second scan.
  @@index([tenantId, name])
  @@map("supplier")
}

// ---------------------------------------------------------------------------
// Purchases (EPIC-11 PUR-001 data foundation). Tenant-scoped purchase draft
// aggregate of the Core `purchases` domain (PRD §17): one purchase names one
// supplier of the same tenant and carries the lines that will become the
// ledger entries when PUR-002 receives it. This slice ships the DRAFT half of
// the lifecycle only — the create/edit/cancel commands land with the API slice
// (PUR-001 P2) and the receive-time ledger transaction with PUR-002.
//
// There is deliberately NO human-readable identifier (DEC-018): the purchase
// is identified by its UUID plus supplier and creation date, so no `number`,
// no `code` and no sequence column exists and no allocation step is implied.
// The cost surface is equally deliberate (DEC-013): one OPTIONAL informational
// `unit_cost`, with no tax rate, no computed line total, no purchase total and
// no valuation derived from it.
//
// Tenant ownership is carried by composite `(tenant_id, id)` keys, so a
// purchase can only reference a supplier of the SAME tenant and a line can
// only reference a purchase and a catalog item of the SAME tenant.
//
// Immutability is CONDITIONAL on the purchase status (DEC-019, refining
// DEC-015): the migration rejects DELETE with a `BEFORE DELETE` trigger on
// each table ONLY while the owning purchase is RECEIVED or CANCELLED, so a
// DRAFT stays fully editable — including dropping a line entered by mistake —
// while a confirmed inventory fact stays immutable and readable.
//
// Data classification: the supplier reference and the purchase quantities are
// INTERNAL, the optional informational unit cost is INTERNAL, and logs and
// audit carry ids and field names only — never a payload. The supplier's own
// identity fields keep their CONFIDENTIAL classification in the supplier
// registry (DEC-011); a purchase stores the reference id only.
// ---------------------------------------------------------------------------

/// Purchase lifecycle (PRD §17), pinned to exactly these three states. Receiving
/// validates DRAFT and marks RECEIVED; CANCELLED is reachable only from DRAFT
/// (DEC-015). Evolve additively only.
enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED

  @@map("purchase_status")
}

/// Tenant-scoped purchase draft (DEC-012, DEC-018). `supplierId` is required
/// and resolved through the composite `(tenantId, supplierId)` FK, so a foreign
/// supplier is not a representable state; the composite `(tenantId, id)` key is
/// what the line FK targets.
///
/// No number, code or sequence column exists (DEC-018): the purchase is
/// identified by its UUID plus supplier and creation date. No total, tax or
/// valuation column exists either (DEC-013).
///
/// A purchase is hard-deletable ONLY while it is DRAFT (DEC-019); the migration
/// rejects DELETE for a RECEIVED or CANCELLED row. Data classification: the
/// supplier reference and the purchase quantities are INTERNAL; logs and audit
/// carry ids and field names only.
model Purchase {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId   String         @map("tenant_id") @db.Uuid
  supplierId String         @map("supplier_id") @db.Uuid
  /// PRD §17 lifecycle. Defaults to DRAFT: a new purchase is a draft until the
  /// explicit receive command (PUR-002) transitions it.
  status     PurchaseStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: the Supplier must be in the SAME tenant.
  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  lines PurchaseLine[]

  /// Tenant-ownership key: target of the composite purchase FK from
  /// `PurchaseLine`.
  @@unique([tenantId, id])
  /// Tenant list lookup: `(tenant_id, status)` serves the status-filtered
  /// purchase list without a second scan (there is no numbering column to sort
  /// on).
  @@index([tenantId, status])
  @@map("purchase")
}

/// Tenant-scoped purchase line (DEC-012, DEC-013). `quantity` is a strictly
/// positive exact `Decimal(10, 3)` — the same scale and scale discipline the
/// EPIC-10 ledger uses — and `unitCost` is an OPTIONAL informational
/// `Decimal(14, 2)` matching the catalog reference-price scale. There is NO tax
/// field, no computed line total, no purchase total and no valuation: nothing
/// derives an amount from this row (DEC-013).
///
/// A duplicate `catalogItemId` within one purchase is rejected by the tenant-
/// leading unique key, which is what makes receiving deterministic (one line,
/// one movement). Both references are composite tenant-ownership FKs, so a line
/// can only reference a purchase and a catalog item of the SAME tenant.
///
/// A line is hard-deletable ONLY while its purchase is DRAFT (DEC-019); the
/// migration rejects DELETE when the owning purchase is RECEIVED or CANCELLED.
/// Data classification: purchase quantities and the optional unit cost are
/// INTERNAL; logs and audit carry ids and field names only.
model PurchaseLine {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  purchaseId    String @map("purchase_id") @db.Uuid
  catalogItemId String @map("catalog_item_id") @db.Uuid

  /// Strictly positive exact quantity, matching the ledger's `Decimal(10, 3)`
  /// scale; the migration adds the `> 0` CHECK (DEC-012).
  quantity Decimal  @db.Decimal(10, 3)
  /// Optional informational unit cost (DEC-013), matching the catalog
  /// reference-price scale. The migration adds the `>= 0` CHECK; a line without
  /// a cost is a valid state and no total is derived from it.
  unitCost Decimal? @map("unit_cost") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: the Purchase must be in the SAME tenant.
  purchase Purchase @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite tenant-ownership FK: the CatalogItem must be in the SAME tenant.
  catalogItem CatalogItem @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  /// One line per catalog item inside one purchase (DEC-012): the duplicate
  /// rejection that keeps receiving deterministic.
  @@unique([tenantId, purchaseId, catalogItemId])
  /// Tenant-ownership key, mirroring every other tenant-scoped aggregate.
  @@unique([tenantId, id])
  @@map("purchase_line")
}

// ---------------------------------------------------------------------------
// Audit scaffolding (design D9).
//
// APPEND-ONLY BOUNDARY: audit_log rows are written exactly once through
// AuditWriter.append() (task 7.1) and are never updated or deleted — no update/
// delete affordance exists anywhere in application code, and this model has no
// mutation surface beyond create. Database-level trigger enforcement is not
// required while the writer boundary holds; immutability tests pin behavior at
// the service layer (spec scenarios owned by task 7.1).
// Data classification: metadata payloads must be sanitized before append;
// CONFIDENTIAL/RESTRICTED material is never logged (engineering rules).
// ---------------------------------------------------------------------------

enum AuditActorType {
  STAFF
  SYSTEM
  /// EPIC-08: a first-party portal holder actor, distinct from staff.
  PORTAL

  @@map("audit_actor_type")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Owning tenant when the audited event is tenant-scoped; null for system-
  /// wide events. FK RESTRICT keeps the trail joinable and indestructible.
  tenantId String? @map("tenant_id") @db.Uuid

  /// Acting staff profile; null for SYSTEM/PORTAL actor rows.
  actorUserProfileId  String?        @map("actor_user_profile_id") @db.Uuid
  /// Acting portal holder; null for STAFF/SYSTEM actor rows (EPIC-08 D5).
  actorPortalAccessId String?        @map("actor_portal_access_id") @db.Uuid
  actorType           AuditActorType @map("actor_type")

  /// Event name in "domain.event" form (e.g. "auth.login").
  action String

  /// Polymorphic target coordinates; kept TEXT because targets span domains.
  targetType String? @map("target_type")
  targetId   String? @map("target_id")

  /// Sanitized event payload (jsonb). Never contains secret/credential material.
  metadata Json @map("metadata")

  requestId String? @map("request_id")

  /// Append-only rows are written once — created_at only, by design D9.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant            Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorProfile      UserProfile?          @relation(fields: [actorUserProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorPortalAccess CustomerPortalAccess? @relation(fields: [actorPortalAccessId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_log")
}
