// NewSaaS persistence foundation.
//
// Conventions (design D2):
// - snake_case tables/columns via @@map/@map; PascalCase singular models.
// - Public IDs are UUID strings defaulted by Postgres gen_random_uuid().
// - Timestamps are timestamptz stored in UTC; converted at boundaries.
// - No floating point money columns.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Staff identity (global — not tenant-scoped). Design D2.
// ---------------------------------------------------------------------------

/// Global person record. Email uniqueness is GLOBAL: login resolves the
/// profile, memberships bind profiles to tenants. Emails are lowercased by the
/// application before persisting; the column itself stores the app-normalized
/// value verbatim.
/// Data classification: email/display_name CONFIDENTIAL; status INTERNAL.
model UserProfile {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  email       String @unique
  displayName String @map("display_name")
  status      String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential  UserCredential?
  sessions    StaffSession[]
  memberships TenantMembership[]
  auditLogs   AuditLog[]

  @@map("user_profile")
}

/// RESTRICTED password material. The primary key SHARED with UserProfile means
/// regular application reads never need to join this table — only the login
/// verification path touches it (design decision; spec: identity / Argon2id
/// storage).
model UserCredential {
  /// Same value as the owning UserProfile.id (1:1, shared primary key).
  userProfileId String @id @map("user_profile_id") @db.Uuid

  /// RESTRICTED — argon2id hash. Never logged, never returned by any API.
  passwordHash String @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("user_credential")
}

/// First-party staff sessions (design D4). One row per login (rotation);
/// logout hard-deletes the row, replay therefore fails lookups.
model StaffSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userProfileId String @map("user_profile_id") @db.Uuid

  /// SHA-256 of the opaque session token — plaintext tokens never persist.
  tokenHash String @unique @map("token_hash")

  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Sessions die with their profile (the only CASCADE in EPIC-01).
  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userProfileId])
  @@map("staff_session")
}

// ---------------------------------------------------------------------------
// Tenancy core (design D2). Tenant creation is ops/seed-only — there is no
// self-service registration surface anywhere in the API.
// ---------------------------------------------------------------------------

/// Membership lifecycle. Values pinned by design D2; evolve additively only.
enum TenantMembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_membership_status")
}

model Tenant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  slug String @unique
  name String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches                Branch[]
  memberships             TenantMembership[]
  portalAccess            CustomerPortalAccess[]
  entitlements            TenantEntitlement[]
  auditLogs               AuditLog[]
  rolePermissionOverrides TenantRolePermissionOverride[]

  @@map("tenant")
}

/// SCHEMA-ONLY SCAFFOLD (spec: persistence / Schema inventory): Branch is inert
/// during EPIC-01 — no endpoint or service creates, reads, updates or deletes
/// rows. Route-enumeration proof lands with task 5.3.
model Branch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  name     String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@map("branch")
}

/// Binds a global staff profile to one tenant with one role. Demonstrates the
/// tenant-safe repository pattern (spec: tenancy-core / Repository pattern).
model TenantMembership {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId      String                 @map("tenant_id") @db.Uuid
  userProfileId String                 @map("user_profile_id") @db.Uuid
  roleId        String                 @map("role_id") @db.Uuid
  status        TenantMembershipStatus

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// One membership per (tenant, profile).
  @@unique([tenantId, userProfileId])
  /// Login resolves memberships by profile; the (tenant_id, profile) unique
  /// index cannot serve that lookup (leading column is tenant_id).
  @@index([userProfileId])
  @@map("tenant_membership")
}

/// INERT SCAFFOLD (spec: persistence / Schema inventory): no endpoint or
/// service touches customer portal access during EPIC-01; FKs toward the
/// future customers domain land when that domain ships.
/// Data classification: contact_email INTERNAL — never logged.
model CustomerPortalAccess {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  contactEmail String @map("contact_email")
  status       String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@map("customer_portal_access")
}

// ---------------------------------------------------------------------------
// RBAC reference data (design D2). Seeded inertly by the reference seed — no
// role-management UI or CRUD API exists (spec: RBAC scope fence). Policy
// evaluation belongs to EPIC-02.
// ---------------------------------------------------------------------------

/// Staff role catalog. `code` is the stable natural key used by the reference
/// seed (OWNER, ADMIN, VETERINARIAN, RECEPTIONIST, CASHIER, INVENTORY_MANAGER).
model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @unique
  name String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships              TenantMembership[]
  rolePermissions          RolePermission[]
  tenantPermissionOverrides TenantRolePermissionOverride[]

  @@map("role")
}

/// Permission catalog. `key` is the stable natural key with the PRD §9
/// `domain.resource.action` shape; uniqueness is global.
model Permission {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  key  String @unique
  name String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permission")
}

/// Role↔permission binding. Surrogate UUID PK plus a compound unique on the
/// pair so the reference seed can upsert by the natural keys.
model RolePermission {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

/// Tenant-LOCAL permission override over a GLOBAL catalog role (EPIC-02,
/// DEC-003). Roles and the permission catalog stay platform baseline
/// (seed-owned CODE); this table is the per-tenant SANDBOX that re-targets a
/// role's effective key set without touching shared rows — the adversarial
/// review (CRITICAL-1) showed globally mutable mappings would let any one
/// tenant rewrite every other tenant's authority.
///
/// Effective set of (tenant T, role R) =
///   (role_permission baseline for R  ∪  overrides(T,R) with granted=true)
///   − overrides(T,R) with granted=false.
///
/// `permission_key` stores the catalog KEY (not an FK): catalog membership is
/// validated at service level against PERMISSION_SEEDS, keeping the override
/// row self-describing while the catalog itself stays immutable code.
model TenantRolePermissionOverride {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId      String  @map("tenant_id") @db.Uuid
  roleId        String  @map("role_id") @db.Uuid
  permissionKey String  @map("permission_key")
  granted       Boolean

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// One override verdict per (tenant, role, catalog key).
  @@unique([tenantId, roleId, permissionKey])
  /// Tenant-scoped administration lookups resolve by (tenant, role).
  @@index([tenantId, roleId])
  @@map("tenant_role_permission_override")
}

// ---------------------------------------------------------------------------
// Entitlements boundary (design D8): boolean capability grants per tenant over
// seeded feature codes. No automatic grants exist — access requires an explicit
// tenant_entitlement row. Callers consult EntitlementsService.has() (task 7.1),
// never plan comparisons.
// ---------------------------------------------------------------------------

/// Feature capability catalog. `code` is the stable natural key; the twelve
/// MVP codes are pinned by PRD §10.
model FeatureCode {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @unique

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  planCapabilities PlanCapability[]
  entitlements     TenantEntitlement[]

  @@map("feature_code")
}

/// Plan catalog. Plans never gate anything directly — they only pre-map
/// feature codes via plan_capability; enforcement goes through grants.
model Plan {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @unique
  name String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  planCapabilities PlanCapability[]

  @@map("plan")
}

/// Plan↔feature-code mapping (the inert starter plan maps all twelve codes).
model PlanCapability {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  planId        String @map("plan_id") @db.Uuid
  featureCodeId String @map("feature_code_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  featureCode FeatureCode @relation(fields: [featureCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([planId, featureCodeId])
  @@map("plan_capability")
}

/// Explicit per-tenant grant. UNIQUE(tenant_id, feature_code_id) doubles as
/// the lookup index for `has(tenantId, featureCode)`.
model TenantEntitlement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  featureCodeId String @map("feature_code_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  featureCode FeatureCode @relation(fields: [featureCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, featureCodeId])
  @@map("tenant_entitlement")
}

// ---------------------------------------------------------------------------
// Audit scaffolding (design D9).
//
// APPEND-ONLY BOUNDARY: audit_log rows are written exactly once through
// AuditWriter.append() (task 7.1) and are never updated or deleted — no update/
// delete affordance exists anywhere in application code, and this model has no
// mutation surface beyond create. Database-level trigger enforcement is not
// required while the writer boundary holds; immutability tests pin behavior at
// the service layer (spec scenarios owned by task 7.1).
// Data classification: metadata payloads must be sanitized before append;
// CONFIDENTIAL/RESTRICTED material is never logged (engineering rules).
// ---------------------------------------------------------------------------

enum AuditActorType {
  STAFF
  SYSTEM

  @@map("audit_actor_type")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Owning tenant when the audited event is tenant-scoped; null for system-
  /// wide events. FK RESTRICT keeps the trail joinable and indestructible.
  tenantId String? @map("tenant_id") @db.Uuid

  /// Acting staff profile; null for SYSTEM actor rows.
  actorUserProfileId String?        @map("actor_user_profile_id") @db.Uuid
  actorType          AuditActorType @map("actor_type")

  /// Event name in "domain.event" form (e.g. "auth.login").
  action String

  /// Polymorphic target coordinates; kept TEXT because targets span domains.
  targetType String? @map("target_type")
  targetId   String? @map("target_id")

  /// Sanitized event payload (jsonb). Never contains secret/credential material.
  metadata Json @map("metadata")

  requestId String? @map("request_id")

  /// Append-only rows are written once — created_at only, by design D9.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorProfile UserProfile? @relation(fields: [actorUserProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_log")
}
