{
  "name": "@newsaas/observability",
  "version": "0.0.0",
  "private": true,
  "description": "Error tracking for the NewSaaS server processes (DEC-093): Sentry, off by default, scrubbed of request and personal data",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --config ../../packages/vitest-config/vitest.node.ts"
  },
  "dependencies": {
    "@sentry/node": "11.8.0"
  },
  "devDependencies": {
    "@newsaas/eslint-config": "workspace:*",
    "@newsaas/typescript-config": "workspace:*",
    "@newsaas/vitest-config": "workspace:*",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
