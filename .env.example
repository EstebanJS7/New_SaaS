# Application environment
NODE_ENV=development

# API binding
API_HOST=0.0.0.0
API_PORT=3001

# Web public API URL (used by the web app's health route proxy)
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
POSTGRES_USER=newsaas
POSTGRES_PASSWORD=newsaas
POSTGRES_DB=newsaas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://newsaas:newsaas@localhost:5432/newsaas?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Demo seed (disabled by default)
ENABLE_DEMO_SEED=false

# Branding assets (disabled by default)
BRANDING_ASSETS_ENABLED=false

# Object storage for branding assets (optional in local/test; in-memory fallback).
# STORAGE_S3_BUCKET is REQUIRED when NODE_ENV=production and
# BRANDING_ASSETS_ENABLED=true; API and worker refuse to start without it.
# Endpoint, region and key prefix are always optional.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_KEY_PREFIX=
# S3 credentials come from the AWS SDK default chain; never commit them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
