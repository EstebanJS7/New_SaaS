# Application environment
NODE_ENV=development

# API binding
API_HOST=0.0.0.0
API_PORT=3001

# Web public API URL (used by the web app's health route proxy)
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
POSTGRES_USER=newsaas
POSTGRES_PASSWORD=newsaas
POSTGRES_DB=newsaas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://newsaas:newsaas@localhost:5432/newsaas?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Demo seed (disabled by default)
ENABLE_DEMO_SEED=false

# Branding assets (disabled by default)
BRANDING_ASSETS_ENABLED=false

# Object storage (HARD-003 / DEC-077).
#
# Distribution of files: branding assets AND asynchronous import artefacts. It is
# optional in single-process local/test runs, where `packages/storage` falls back
# to a PER-PROCESS in-memory driver.
#
# It is REQUIRED in any environment that runs more than one process — every
# deployment, and the browser lane — because the fallback cannot cross a process
# boundary: the API stores an uploaded artefact in its own memory and the worker
# cannot read it. That is TD-060.
#
# Also REQUIRED when NODE_ENV=production and BRANDING_ASSETS_ENABLED=true; the API
# and the worker refuse to start without it.
#
# `docker compose up -d` starts a MinIO that serves these defaults; the bucket is
# created by the lane's globalSetup, or by hand for other environments.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_KEY_PREFIX=
# S3 credentials come from the AWS SDK default chain; never commit them.
# MinIO wants its own root credentials here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
